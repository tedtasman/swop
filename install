#!/usr/bin/env bash
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
NAME="${SCRIPT_DIR##*/}" 

# install in ~/.local/bin
mkdir -p ~/.local/bin
ln -s "$SCRIPT_DIR/swop" "$HOME/.local/bin/swop" && printf "swop installed at ~/.local/bin/swop\n"



# ~/.local/bin to PATH if not there
if ! [[ ":$PATH:" == *":$HOME/.local/bin:"* ]] && ! grep -q '$HOME/.local/bin' ~/.bashrc; then
    cat >> ~/.bashrc <<'EOF'

# swop - add ~/.local/bin to PATH
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
esac
EOF

    . "$HOME/.bashrc" && printf "~/.local/bin/ added to PATH\n"
fi
